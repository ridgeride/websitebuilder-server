+import {test,after,beforeEach} from 'node:test';
+import assert from 'node:assert/strict';
+import {DatabaseSync} from 'node:sqlite';
+import {readFileSync,readdirSync} from 'node:fs';
+import {createHmac} from 'node:crypto';
+import {candleCoverage,sourceConfirmedCoverage,minuteRangeCoverage,learningEligible,COVERAGE_POLICY,EXECUTION_POLICY} from '../lib/research-policy.ts';
+import {initialExitState,advanceExit,priceConfirmedAt} from '../lib/adaptive-exits.ts';
+
+const sqlite=new DatabaseSync(':memory:');
+for(const n of readdirSync(new URL('../migrations/',import.meta.url)).filter(n=>n.endsWith('.sql')).sort())sqlite.exec(readFileSync(new URL('../migrations/'+n,import.meta.url),'utf8'));
+function prepare(query,args=[]){return {query,args,bind(...v){return prepare(query,v);},async first(){return sqlite.prepare(query).get(...args)||null;},async raw(){const s=sqlite.prepare(query);s.setReturnArrays(true);return s.all(...args);},async all(){return {results:sqlite.prepare(query).all(...args),success:true,meta:{}};},async run(){return {results:[],success:true,meta:sqlite.prepare(query).run(...args)};}};}
+globalThis.__CLOUDFLARE_ENV__={DB:{prepare,async batch(statements){sqlite.exec('BEGIN');try{const out=[];for(const s of statements)out.push(await s.run());sqlite.exec('COMMIT');return out;}catch(e){sqlite.exec('ROLLBACK');throw e;}}}};
+after(()=>sqlite.close());
+
+const {marketDataMode,marketDataRejection,resetMarketDataAuthForTests}=await import('../lib/bitvavo-market-auth.ts');
+const {publicSourceState,pausePublicSource,trafficSnapshot}=await import('../lib/bitvavo-traffic.ts');
+const {publicMarketJson}=await import('../lib/public-market-cache.ts');
+const {fetchBitvavoMinuteCandlesRange}=await import('../lib/chart-engine.ts');
+const {evaluateOpenStrategyTrials}=await import('../lib/strategy-engine.ts');
+const {evaluationBacklog}=await import('../lib/research-health.ts');
+const {getDb}=await import('../db/index.ts');
+const {strategyTrials}=await import('../db/schema.ts');
+
+const candle=(timestamp,open=100,high=101,low=99,close=100)=>({timestamp,open,high,low,close,volume:10});
+const row=c=>[c.timestamp,String(c.open),String(c.high),String(c.low),String(c.close),String(c.volume)];
+const KEY='fixture-read-only-key',SECRET='fixture-secret';
+function useKeys(on){if(on){process.env.BITVAVO_API_KEY=KEY;process.env.BITVAVO_API_SECRET=SECRET;}else{delete process.env.BITVAVO_API_KEY;delete process.env.BITVAVO_API_SECRET;}resetMarketDataAuthForTests();}
+beforeEach(()=>{useKeys(false);sqlite.prepare("DELETE FROM public_market_cache").run();});
+
+test('source-confirmed minute coverage counts quiet minutes without weakening invalid data checks',()=>{
+ const rows=[candle(0),candle(180000)];
+ assert.equal(candleCoverage(rows,0,240000,60000).quality,'gaps_unresolved');
+ const quiet=sourceConfirmedCoverage(rows,0,240000,60000);
+ assert.equal(quiet.quality,'continuous');assert.equal(quiet.quietMinutes,2);assert.equal(quiet.missing,0);assert.equal(quiet.sourceConfirmed,true);assert.equal(quiet.policy,COVERAGE_POLICY.version);
+ assert.equal(sourceConfirmedCoverage([candle(0,100,99,98,100)],0,60000,60000).quality,'invalid');
+ assert.equal(sourceConfirmedCoverage([candle(0),candle(0)],0,60000,60000).quality,'invalid');
+ assert.equal(minuteRangeCoverage({candles:rows,from:0,to:240000}).quality,'gaps_unresolved');
+ assert.equal(minuteRangeCoverage({candles:rows,from:0,to:240000,coverage:quiet}).quality,'continuous');
+});
+
+test('a fully received sparse Bitvavo window is continuous with its quiet minutes recorded',async()=>{
+ const original=globalThis.fetch,now=Math.floor(Date.now()/60000)*60000,from=now-10*60000;
+ globalThis.fetch=async()=>Response.json([candle(from),candle(from+4*60000),candle(from+9*60000)].map(row));
+ try{const range=await fetchBitvavoMinuteCandlesRange('QUIET-EUR',from,now,10);
+  assert.equal(range.candles.length,3);assert.equal(range.coverage.quality,'continuous');assert.equal(range.coverage.quietMinutes,7);assert.equal(range.complete,true);
+ }finally{globalThis.fetch=original;}
+});
+
+test('an open position in a quiet market expires at its last traded price once the window is confirmed',()=>{
+ const s=initialExitState({variant:'fixed',direction:'long',price:100,stop:90,target:130,atr:2,notional:500,openedAt:0,maximumHours:1});
+ const traded=advanceExit(s,[candle(0),candle(20*60000,100,103,99,102)],25*60000);
+ assert.equal(traded.lastPriceAt,21*60000);assert.equal(traded.lastPrice,102);
+ const unconfirmed=advanceExit({...traded,through:3600000},[],3600000+120000);
+ assert.equal(unconfirmed.status,'open','without source confirmation a long silence is still not a valid expiry');
+ const confirmed=advanceExit(traded,[],3600000+120000,3600000);
+ assert.equal(confirmed.status,'expired');assert.equal(confirmed.quietThrough,3600000);
+ const exit=confirmed.events.at(-1);assert.equal(exit.kind,'expired');assert.equal(exit.at,3600000);assert.ok(Math.abs(exit.price-102*(1-s.slippageRate))<1e-9);
+ assert.match(exit.reason,/geen handel/);
+ const quietOpen=advanceExit(traded,[],40*60000,40*60000);
+ assert.equal(quietOpen.status,'open');assert.equal(priceConfirmedAt(quietOpen),40*60000);assert.equal(priceConfirmedAt(traded),21*60000);
+});
+
+test('market candles are signed with the owner key and pause separately from the shared anonymous IP limit',async()=>{
+ useKeys(true);
+ const original=globalThis.fetch,seen=[];
+ globalThis.fetch=async(url,init)=>{seen.push({url:String(url),headers:new Headers(init.headers)});return Response.json([]);};
+ try{
+  assert.equal(await marketDataMode(),'account');
+  await publicMarketJson('https://api.bitvavo.com/v2/SIGN-EUR/candles?limit=10&interval=1h');
+  const h=seen[0].headers,ts=h.get('bitvavo-access-timestamp');
+  assert.equal(h.get('bitvavo-access-key'),KEY);assert.equal(h.get('bitvavo-access-window'),'10000');
+  const expected=createHmac('sha256',SECRET).update(ts+'GET'+'/v2/SIGN-EUR/candles?interval=1h&limit=10').digest('hex');
+  assert.equal(h.get('bitvavo-access-signature'),expected);
+  assert.ok(!JSON.stringify(sqlite.prepare('SELECT * FROM public_market_cache').all()).includes(SECRET));
+  const now=Date.now();
+  sqlite.prepare("INSERT INTO public_market_cache(id,payload_json,expires_at) VALUES('bitvavo:cooldown',?,?)").run(JSON.stringify({reason:'shared IP'}),now+3600000);
+  assert.equal(await publicSourceState(),null,'an anonymous IP pause does not stop signed requests');
+  await publicMarketJson('https://api.bitvavo.com/v2/SIGN2-EUR/candles?limit=10&interval=1h');assert.equal(seen.length,2);
+  await pausePublicSource(now+60000,'account unit');
+  assert.equal(sqlite.prepare("SELECT count(*) n FROM public_market_cache WHERE id='bitvavo:cooldown:account'").get().n,1);
+  assert.equal((await publicSourceState()).reason,'account unit');
+  assert.equal((await trafficSnapshot()).marketData.mode,'account');
+ }finally{globalThis.fetch=original;}
