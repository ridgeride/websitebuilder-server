+let rejectedUntil=0;
+let rejectedReason='';
+const signingKeys=new Map<string,Promise<CryptoKey>>();
+
+async function automationOwner(){
+ try{
+  const raw=getDb().$client;
+  const row=await raw.prepare('SELECT owner_hash FROM automation_settings WHERE id=1').first<{owner_hash:string}>();
+  if(row?.owner_hash)return row.owner_hash;
+  const vault=await raw.prepare('SELECT owner_hash FROM api_credentials LIMIT 1').first<{owner_hash:string}>();
+  return vault?.owner_hash||'';
+ }catch{return '';}
+}
+
+async function resolveAuth():Promise<Auth|null>{
+ if(String(process.env.BITVAVO_MARKET_DATA_AUTH||'').toLowerCase()==='off')return null;
+ try{
+  const values=await credentialValuesForOwner(await automationOwner(),['BITVAVO_API_KEY','BITVAVO_API_SECRET']);
+  const apiKey=values.BITVAVO_API_KEY?.trim(),apiSecret=values.BITVAVO_API_SECRET?.trim();
+  return apiKey&&apiSecret?{apiKey,apiSecret}:null;
+ }catch{return null;}
+}
+
+async function currentAuth(now=Date.now()){
+ if(now<rejectedUntil)return null;
+ if(!cached||now-cached.at>CACHE_MS)cached={at:now,value:resolveAuth()};
+ return cached.value;
+}
+
+export async function marketDataMode(now=Date.now()):Promise<MarketDataMode>{
+ return (await currentAuth(now))?'account':'anonymous';
+}
+
+export function marketDataRejection(now=Date.now()){
+ return now<rejectedUntil?{until:rejectedUntil,reason:rejectedReason}:null;
+}
+
+/** A rejected key falls back to anonymous requests instead of blocking every candle check. */
+export function rejectMarketDataAuth(status:number,errorCode=NaN,now=Date.now()){
+ rejectedUntil=now+REJECTED_PAUSE_MS;
+ rejectedReason=`Bitvavo weigerde de API-sleutel voor marktdata (HTTP ${status}${Number.isFinite(errorCode)?` · errorCode ${errorCode}`:''}); tijdelijk anoniem.`;
+ cached=null;
+}
+
+export function resetMarketDataAuthForTests(){cached=null;rejectedUntil=0;rejectedReason='';signingKeys.clear();}
+
+function hex(buffer:ArrayBuffer){return [...new Uint8Array(buffer)].map(b=>b.toString(16).padStart(2,'0')).join('');}
+
+export async function marketDataHeaders(url:string,method='GET',now=Date.now()):Promise<Record<string,string>|null>{
+ const auth=await currentAuth(now);if(!auth)return null;
+ const parsed=new URL(url);
+ const timestamp=String(now);
+ let key=signingKeys.get(auth.apiSecret);
+ if(!key){key=crypto.subtle.importKey('raw',new TextEncoder().encode(auth.apiSecret),{name:'HMAC',hash:'SHA-256'},false,['sign']);signingKeys.set(auth.apiSecret,key);}
+ const signature=hex(await crypto.subtle.sign('HMAC',await key,new TextEncoder().encode(timestamp+method.toUpperCase()+parsed.pathname+parsed.search)));
+ return {'Bitvavo-Access-Key':auth.apiKey,'Bitvavo-Access-Signature':signature,'Bitvavo-Access-Timestamp':timestamp,'Bitvavo-Access-Window':'10000'};
+}
