+export type MinuteCoverage=ReturnType<typeof candleCoverage>&{quietMinutes?:number;sourceConfirmed?:boolean;policy?:string};
+export function sourceConfirmedCoverage(rows:CandleLike[],from:number,to:number,ms:number):MinuteCoverage {
+  const base=candleCoverage(rows,from,to,ms);
+  if(base.quality==='invalid')return {...base,quietMinutes:0,sourceConfirmed:true,policy:COVERAGE_POLICY.version};
+  return {...base,missing:0,quality:'continuous',quietMinutes:base.missing,sourceConfirmed:true,policy:COVERAGE_POLICY.version,
+    explanation:base.missing?`${base.missing} minuten zonder handel op Bitvavo; bronvenster volledig ontvangen.`:null};
