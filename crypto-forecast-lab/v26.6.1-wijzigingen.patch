+import {getDb} from '../db';
+import {credentialValuesForOwner} from './credentials';
+
+/**
+ * Bitvavo counts unauthenticated requests per IP and authenticated requests per account.
+ * Cloudflare Workers share outbound addresses, so public candles are signed with the
+ * owner's read-only key when one is available. The key never leaves the server.
+ */
+export type MarketDataMode='account'|'anonymous';
+type Auth={apiKey:string;apiSecret:string};
