+/**
+ * v26.6.1: Bitvavo publishes no 1m candle for a minute without trades. Inside a window that was
+ * fully received from Bitvavo, such a minute is a confirmed quiet minute: nothing traded, so no
+ * paper stop or target can fill there. Invalid or duplicate rows still reject the window.
+ */
+export const COVERAGE_POLICY={version:'coverage26_6_1-v1',
