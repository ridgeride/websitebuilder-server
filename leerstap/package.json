{
  "name": "leerstap",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning scripts/serve.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e.mjs",
    "check": "npm test && npm run build && wrangler deploy --dry-run --outdir dist/worker",
    "db:migrate": "wrangler d1 migrations apply leerstap --remote",
    "deploy": "npm run check && node scripts/check-release.mjs && npm run db:migrate && wrangler deploy",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "jspdf": "4.2.1",
    "jszip": "3.10.1",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "playwright-core": "1.56.1",
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=22.13"
  }
}
