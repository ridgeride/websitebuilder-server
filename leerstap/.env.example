# Alleen voor lokaal draaien (npm start). Online staan deze waarden als Cloudflare-secret; zie UITROL.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MONTHLY_LIMIT=30
# Optioneel: alleen mensen met deze code kunnen een account maken (besloten proef).
INVITE_CODE=
# Optioneel: alleen met een uitnodiging (persoonlijk via Beheer, of INVITE_CODE) een account maken.
INVITE_ONLY=
# Wie de pagina Beheer ziet: e-mailadressen van ouderaccounts, gescheiden door komma's.
ADMIN_EMAILS=
PORT=4173
